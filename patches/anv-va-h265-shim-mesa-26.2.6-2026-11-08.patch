+/* Record the slice layout the application asked for, so we can (a) drive the
+ * encoder with it and (b) check whether the produced bitstream matches. */
+static uint32_t g_app_slices;
+static uint32_t g_app_slice_addr[16];
+static uint32_t g_app_slice_addr_count;
+
+void anv_va_note_slices(uint32_t count, const uint32_t *addresses, uint32_t n_addr)
+{
+   const uint32_t n = MIN2(n_addr, ARRAY_SIZE(g_app_slice_addr));
+   bool changed = count != g_app_slices;
+   for (uint32_t i = 0; i < n && !changed; i++)
+      changed = addresses[i] != g_app_slice_addr[i];
+   g_app_slices = count;
+   g_app_slice_addr_count = n;
+   for (uint32_t i = 0; i < n; i++)
+      g_app_slice_addr[i] = addresses[i];
+   if (changed) {
+      char buf[256];
+      size_t off = 0;
+      off += snprintf(buf + off, sizeof buf - off,
+                      "app asks for %u slice(s), segment addresses:", count);
+      for (uint32_t i = 0; i < n && off + 12 < sizeof buf; i++)
+         off += snprintf(buf + off, sizeof buf - off, " %u", addresses[i]);
+      VLOG("%s", buf);
+   }
+}
+
+uint32_t anv_va_app_slices(void)
+{
+   return g_app_slices;
+}
