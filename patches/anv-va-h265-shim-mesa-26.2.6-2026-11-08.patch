@@ -0,0 +1,3517 @@
+#include "anv_va_encode.h"
+#include <stdio.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+static void va_stage_on_submit_thread(struct anv_device *device,
