+#include <libdrm/drm_fourcc.h>
+#include <xf86drm.h>
+#include <linux/dma-buf.h>
+#include <sys/ioctl.h>
+#include <poll.h>
+#include "util/cache_ops.h"
+#include "util/os_time.h"
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdarg.h>
+
+
+static int64_t va_t0(void)
+{
+   static int64_t t0;
+   if (!t0) t0 = os_time_get_nano();
+   return t0;
+}
+
+/* ANV_VA_LOG lets a test process (the harness) keep a log of its own instead
+ * of interleaving with the live vrserver. */
+static const char *va_log_path(void)
+{
+   static const char *path;
+   if (!path) {
+      path = getenv("ANV_VA_LOG");
+      if (!path || !*path)
+         path = "/tmp/anv-va.log";
+   }
+   return path;
+}
+
+#define VLOG(...) do { \
+   FILE *f_ = fopen(va_log_path(), "a"); \
+   if (f_) { fprintf(f_, "ANV-VA: [%6.0f] ", \
+                     (os_time_get_nano() - va_t0()) / 1e6); \
+             fprintf(f_, __VA_ARGS__); \
+             fputc('\n', f_); fclose(f_); } \
+} while (0)
+
+static bool va_env_flag(const char *name)
+{
+   const char *v = getenv(name);
+   return v && *v && strcmp(v, "0") != 0;
+}
+static uint32_t va_env_u32(const char *name, uint32_t def)
+{
+   const char *v = getenv(name);
+   return v && *v ? (uint32_t) strtoul(v, NULL, 0) : def;
+}
+static uint64_t va_env_u64(const char *name, uint64_t def)
+{
+   const char *v = getenv(name);
+   return v && *v ? (uint64_t) strtoull(v, NULL, 0) : def;
+}
+static double va_env_double(const char *name, double def)
+{
+   const char *v = getenv(name);
+   return v && *v ? atof(v) : def;
+}
+
+/* Encoder options that trade bitstream robustness for packetized transfer.
+ * Read from ANV_VA_* environment variables.  They must be in the environment
+ * of the process that loads the ICD (SteamVR/vrserver), so a change takes
+ * effect after a SteamVR restart; /tmp is only used for debug output.
+ *   ANV_VA_SLICES     slices per frame (smaller loss units)
+ *   ANV_VA_TILES      "CxR" tile columns x rows (independent CTU groups)
+ *   ANV_VA_MAXFRAME   max frame size in bytes (bounds the on-wire burst)
+ *   ANV_VA_AUD        presence adds access unit delimiters (frame framing)
+ *   ANV_VA_BITRATE    bitrate cap in bit/s (smaller frames/bursts)
+ */
+struct va_enc_opts {
+   uint32_t slices, tile_cols, tile_rows, max_frame_size, aud;
+   uint64_t bitrate_cap;
+   /* Rate control: 0 = follow the application (CBR), 1 = constant QP.
+    * CQP is the default because vrlink's target swings by more than 4x, which
+    * makes a CBR encoder swing in quality (visible macroblocks/ringing). */
+   uint32_t cqp;
+   uint32_t qp;
+   /* QP limits carried in the per-frame VAEncMiscParameterRateControl.
+    * 0 = no limit, which is what the stream was validated with.  They are
+    * the knobs that bound how far iHD's rate controller may swing, so the
+    * delivered/requested ratio can be traded against quality without a
+    * rebuild: ANV_VA_MINQP, ANV_VA_MAXQP. */
+   uint32_t min_qp, max_qp;
+   /* Rate-control deadband (percent of the applied rate) and the VBV floor in
+    * frames, from ANV_VA_RC_DEADBAND / ANV_VA_VBV_FRAMES. */
+   uint32_t rc_deadband, vbv_frames;
+   /* Honour the application's slice boundaries (the default). */
+   uint32_t slice_layout;
+   /* Optional quality floor as bits per pixel of the encoded stream.  Off by
+    * default - the application's rate control is the envelope - and only set
+    * from ANV_VA_BPP_FLOOR (or ANV_VA_BPP) if a floor is ever wanted. */
+   double bpp_floor;
+};
+
+static bool va_enc_opts_equal(const struct va_enc_opts *a,
+                              const struct va_enc_opts *b)
+{
+   return a->slices == b->slices && a->tile_cols == b->tile_cols &&
+          a->tile_rows == b->tile_rows && a->max_frame_size == b->max_frame_size &&
+          a->aud == b->aud && a->bitrate_cap == b->bitrate_cap &&
+          a->cqp == b->cqp && a->qp == b->qp &&
+          a->min_qp == b->min_qp && a->max_qp == b->max_qp &&
+          a->rc_deadband == b->rc_deadband && a->vbv_frames == b->vbv_frames &&
+          a->bpp_floor == b->bpp_floor &&
+          a->slice_layout == b->slice_layout;
+}
+
+static struct va_enc_opts va_enc_opts_read(void)
+{
+   struct va_enc_opts o = { .slices = 1 };
+   const uint32_t app_slices = anv_va_app_slices();
+   if (app_slices)
+      o.slices = app_slices;
+   o.slices = va_env_u32("ANV_VA_SLICES", o.slices);
+   if (o.slices < 1) o.slices = 1;
+   if (o.slices > 32) o.slices = 32;
+   const char *tiles = getenv("ANV_VA_TILES");
+   if (tiles) {
+      unsigned c = 0, r = 0;
+      if (sscanf(tiles, "%ux%u", &c, &r) == 2) { o.tile_cols = c; o.tile_rows = r; }
+   }
+   o.max_frame_size = va_env_u32("ANV_VA_MAXFRAME", 0);
+   o.bitrate_cap = va_env_u64("ANV_VA_BITRATE", 0);
+   if (o.bitrate_cap < 1000000)
+      o.bitrate_cap = 0;
+   o.aud = va_env_flag("ANV_VA_AUD");
+   o.slice_layout = va_slice_layout_enabled();
+   o.bpp_floor = va_env_double("ANV_VA_BPP_FLOOR", 0);
+   if (!(o.bpp_floor > 0 && o.bpp_floor <= 4))
+      o.bpp_floor = va_env_double("ANV_VA_BPP", 0);
+   if (!(o.bpp_floor > 0 && o.bpp_floor <= 4))
+      o.bpp_floor = 0;
+   o.cqp = va_env_flag("ANV_VA_CQP");
+   o.qp = va_env_u32("ANV_VA_QP", 24);
+   if (o.qp < 1 || o.qp > 51) o.qp = 24;
+   o.min_qp = va_env_u32("ANV_VA_MINQP", 0);
+   if (o.min_qp > 51) o.min_qp = 0;
+   o.max_qp = va_env_u32("ANV_VA_MAXQP", 0);
+   if (o.max_qp > 51) o.max_qp = 0;
+   o.rc_deadband = va_env_u32("ANV_VA_RC_DEADBAND", 5);
+   if (o.rc_deadband > 50) o.rc_deadband = 5;
+   o.vbv_frames = va_env_u32("ANV_VA_VBV_FRAMES", 4);
+   if (o.vbv_frames > 32) o.vbv_frames = 4;
+   return o;
+}
+
+/* ==== Direct libva encode backend ========================================
+ *
+ * ANV has no native Vulkan H.265 encode implementation.  This file implements
+ * the Vulkan video encode entry points on top of libva/iHD: session parameters
+ * and packed headers, source-image import, the per-frame encode, the
+ * destination slots and the encode-feedback queries.  The rate-control, slice
+ * and packed-header parameter buffers are built per frame so the application's
+ * requests are honoured without reopening the encoder.
+ */
+#define VA_RECON_SURFACES  4
+#define VA_CODED_BUFFERS   2
+#define VA_MAX_SLICES      32
+
+/* HEVC constants used by the parameter buffers. */
+#define VA_HEVC_NAL_IDR_W_RADL 19
+#define VA_HEVC_SLICE_I         2
+#define VA_HEVC_INIT_QP        30   /* init_qp_minus26 = 4, as iHD accepted */
+#define VA_HEVC_DIFF_CU_QP      3
+
+struct anv_va_session {
+   VkFormat fmt;
+   uint32_t w, h, fps;
+   /* Bit rate the encoder is being told to use, in bit/s.  Updated per frame
+    * from the application's VkVideoEncodeRateControlInfoKHR; nothing is
+    * cached inside a wrapper any more.  Mirrors g_stream.bitrate, kept per
+    * session so a context created later starts from the current target. */
+   uint64_t bitrate;
+   bool ten_bit;
+   bool ready;
+   /* Set once the application's own rate control has been adopted, so the
+    * first target after it appears is applied even if it is inside the
+    * deadband of the startup heuristic. */
+   bool rc_from_app;
+   uint32_t profile_idc;      /* HEVC general_profile_idc: 1 Main, 2 Main10 */
+   uint32_t va_profile;       /* VAProfileHEVCMain / VAProfileHEVCMain10 */
+   uint32_t rt_format;        /* VA_RT_FORMAT_YUV420 / _10 */
+   uint32_t fourcc;           /* VA_FOURCC_NV12 / VA_FOURCC_P010 */
+   uint32_t level_idc;
+   uint32_t rc_mode;          /* VA_RC_CBR or VA_RC_CQP */
+   uint32_t fixed_qp;         /* CQP only */
+   uint32_t max_frame_size;   /* 0 = not requested */
+   bool packed_headers;
+   bool sao, amp, temporal_mvp;
+   /* The VA-API display is shared by all three slot contexts: one
+    * vaInitialize, three VAConfigs/VAContexts.  Only the header-only session
+    * (created before a video session exists) owns its display; the set owns
+    * it once the first slot adopts that session. */
+   int drm_fd;                /* owned dup, only when owns_dpy */
+   VADisplay dpy;
+   bool owns_dpy;
+   VAConfigID cfg;
+   VAContextID ctx;
+   VASurfaceID recon[VA_RECON_SURFACES];
+   unsigned recon_pos;
+   VABufferID coded[VA_CODED_BUFFERS];
+   unsigned coded_pos;
+   size_t coded_size;
+   uint8_t *headers;          /* VPS + SPS + PPS, start codes included */
+   size_t headers_size;
+   struct va_enc_opts opts;
+   uint64_t frames;
+   /* Destination slot this context belongs to (0/1/2 = 0/4M/8M).  The
+    * application treats each 4 MB slot as its own region; see va_sessions. */
+   uint32_t slot;
+};
+
+/* One video session's encoder contexts, one per destination slot.
+ *
+ * The application's buffer is three 4 MB slots at 0 / 4 M / 8 M and it reads
+ * each slot as a separate region, not as "size bytes at offset".  A single
+ * context rotating 0/4M/8M does not hand the third slot over correctly (the
+ * frame written there reaches the client all-zero while the bytes are in
+ * memory), so each slot gets its own VAConfig/VAContext, its own recon
+ * surfaces, coded buffers and therefore its own rate controller.
+ *
+ * The parameter sets must stay identical across the three: the application
+ * gets VPS/SPS/PPS out of band from one of them and the client decodes all
+ * three streams against that copy.  backend_create() therefore clones the
+ * first session's configuration and headers into the others.
+ */
+#define VA_SLOT_COUNT 3
+#define VA_SLOT_BYTES (4u << 20)
+
+struct va_sessions {
+   VkFormat fmt;
+   uint32_t w, h;
+   /* One VA-API display for all three contexts (see struct anv_va_session). */
+   int drm_fd;
+   VADisplay dpy;
+   struct anv_va_session *slot[VA_SLOT_COUNT];
+   /* A slot whose session could not be created falls back to the primary
+    * session (single-session behaviour) instead of dropping frames. */
+   bool slot_failed[VA_SLOT_COUNT];
+};
+
+/* Feedback entries are written by the encode worker and read by the
+ * application (vkGetQueryPoolResults), possibly from another thread, so they
+ * are protected by a mutex and the reader can wait for the worker. */
+typedef struct {
+   VkQueryPool pool;
+   uint32_t index, off, size;
+   uint32_t gen;     /* generation of the job that owns this entry */
+   bool ready;
+} VaFeedback;
+static VaFeedback g_fb[4096];
+static int g_nfb;
+static uint32_t g_fb_gen;
+static pthread_mutex_t g_fb_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t g_fb_cond = PTHREAD_COND_INITIALIZER;
+
+static VaFeedback *fb_find(VkQueryPool pool, uint32_t index)
+{
+   for (int i = 0; i < g_nfb; i++)
+      if (g_fb[i].pool == pool && g_fb[i].index == index)
+         return &g_fb[i];
+   if (g_nfb < 4096) {
+      g_fb[g_nfb] = (VaFeedback){ pool, index, 0, 0, 0, false };
+      return &g_fb[g_nfb++];
+   }
+   return NULL;
+}
+
+/* Generations make the hand-off to the application ordered.  The application
+ * reuses a small query ring, so the job that used slot K three frames ago can
+ * still be running when slot K is cleared for the current frame; before this,
+ * that older job's feedback_set() satisfied the application's wait, which then
+ * read (and transmitted) the *previous* frame's bitstream out of the
+ * destination buffer while the current one was being written into it. */
+static void feedback_set(VkQueryPool pool, uint32_t index, uint32_t gen,
+                         uint32_t off, uint32_t size) {
+   pthread_mutex_lock(&g_fb_lock);
+   VaFeedback *e = fb_find(pool, index);
+   if (e && e->gen == gen) {
+      e->off = off; e->size = size; e->ready = true;
+      pthread_cond_broadcast(&g_fb_cond);
+   } else if (e) {
+      static int stale;
+      if (stale++ < 20)
+         VLOG("feedback: dropped stale result for slot %u (gen %u, entry now %u)",
+              index, gen, e->gen);
+   }
+   pthread_mutex_unlock(&g_fb_lock);
+}
+
+static uint32_t feedback_clear(VkQueryPool pool, uint32_t index)
+{
+   pthread_mutex_lock(&g_fb_lock);
+   VaFeedback *e = fb_find(pool, index);
+   uint32_t gen = ++g_fb_gen;
+   if (e) { e->gen = gen; e->ready = false; e->off = 0; e->size = 0; }
+   pthread_mutex_unlock(&g_fb_lock);
+   return gen;
+}
+
+/* Block until the encode worker published the packet for this query, so the
+ * application can keep using vkQueueSubmit asynchronously. */
+bool anv_va_feedback_wait(VkQueryPool pool, uint32_t index, uint64_t timeout_ns)
+{
+   const int64_t t0 = os_time_get_nano();
+   struct timespec ts;
+   clock_gettime(CLOCK_REALTIME, &ts);
+   ts.tv_nsec += (long)(timeout_ns % 1000000000ull);
+   ts.tv_sec += (time_t)(timeout_ns / 1000000000ull);
+   if (ts.tv_nsec >= 1000000000L) { ts.tv_sec++; ts.tv_nsec -= 1000000000L; }
+
+   pthread_mutex_lock(&g_fb_lock);
+   VaFeedback *e = fb_find(pool, index);
+   bool ready = e && e->ready;
+   while (!ready) {
+      if (pthread_cond_timedwait(&g_fb_cond, &g_fb_lock, &ts) == ETIMEDOUT)
+         break;
+      ready = e && e->ready;
+   }
+   pthread_mutex_unlock(&g_fb_lock);
+   {
+      static int64_t last_log;
+      const double ms = (os_time_get_nano() - t0) / 1e6;
+      if (ms > 2.0 && (last_log == 0 || os_time_get_nano() - last_log > 200000000)) {
+         last_log = os_time_get_nano();
+         VLOG("feedback wait: application blocked %.1f ms (ready=%d)", ms, ready);
+      }
+   }
+   return ready;
+}
+
+static struct anv_va_session *va_pending;
+static VkFormat va_pending_fmt;
+static uint32_t va_pending_w, va_pending_h;
+
+
+/* Diagnostic: dump plane 0 of the encode source twice (before and after the
+ * encode) so we can tell whether the application is still writing it while we
+ * read it.  Only meaningful when the image is mappable (BAR memory). */
+static void va_dump_plane(struct anv_device *device, struct anv_address a,
+                          uint64_t bytes, const char *path)
+{
+   void *m = NULL;
+   if (anv_device_map_bo(device, a.bo, 0, a.bo->size, NULL, &m) != VK_SUCCESS) {
+      VLOG("dump map failed for %s", path);
+      return;
+   }
+   FILE *f = fopen(path, "wb");
+   if (f) { fwrite((char *)m + a.offset, 1, bytes, f); fclose(f); }
+   VLOG("dumped %s (%s)", path, f ? "ok" : "open failed");
+   anv_device_unmap_bo(device, a.bo, m, a.bo->size, false);
+}
+
+/* Deferred retirement of staging buffers.
+ *
+ * iHD imports the staging buffer's dma-buf into a VASurface and can keep that
+ * surface in its internal pool after we are done with the frame.  Freeing the
+ * BO immediately lets the next frame's allocation land on the same address
+ * (the two alternating pointers we see in the log), which is a use-after-free
+ * if iHD ever touches the surface again - and the symptom of that is a
+ * truncated last slice.  Keep the last VA_STAGE_RING buffers alive before
+ * releasing them, which gives the encoder ~100 ms at 90 fps to move on. */
+#define VA_STAGE_RING 8
+static struct {
+   VkBuffer buf;
+   VkDeviceMemory mem;
+} va_stage_ring[VA_STAGE_RING];
+static unsigned va_stage_pos;
+
+static void va_release_linear(struct anv_device *device, struct anv_va_job *job)
+{
+   VkDevice dev = anv_device_to_handle(device);
+   if (job->linear_buf == VK_NULL_HANDLE && job->linear_mem == VK_NULL_HANDLE)
+      return;
+
+   unsigned slot = va_stage_pos++ % VA_STAGE_RING;
+   if (va_stage_ring[slot].buf != VK_NULL_HANDLE)
+      anv_DestroyBuffer(dev, va_stage_ring[slot].buf, NULL);
+   if (va_stage_ring[slot].mem != VK_NULL_HANDLE)
+      anv_FreeMemory(dev, va_stage_ring[slot].mem, NULL);
+   va_stage_ring[slot].buf = job->linear_buf;
+   va_stage_ring[slot].mem = job->linear_mem;
+   job->linear_buf = VK_NULL_HANDLE;
+   job->linear_mem = VK_NULL_HANDLE;
+}
+
+/* Row pitch in bytes of the tightly packed P010/NV12 staging buffer. */
+static uint32_t va_tight_pitch(VkFormat fmt, uint32_t w)
+{
+   const uint32_t nplanes = vk_format_get_plane_count(fmt);
+   VkFormat f0 = vk_format_get_aspect_format(
+      fmt, nplanes > 1 ? VK_IMAGE_ASPECT_PLANE_0_BIT : VK_IMAGE_ASPECT_COLOR_BIT);
+   return w * vk_format_get_blocksize(f0);
+}
+
+/* Allocate an exportable linear staging buffer, bind it, and record a
+ * vkCmdCopyImageToMemoryKHR of the source image into it.  The buffer is
+ * exported as a dma-buf in anv_va_encode_job() and imported by VA-API as a
+ * plain linear P010/NV12 surface, so no tiled layout is ever assumed. */
+
+/* The VA encode blocks for ~10 ms per 1024x4096 frame (iHD is
+ * synchronous).  Doing that inside vkQueueSubmit stalls the application's
+ * submit thread and destroys frame pacing, so the jobs are handed to a
+ * single worker thread.  Encode order is preserved and the app's fence has
+ * already been waited for (the submitted batch only contains the video
+ * coding-scope commands), so the source image is complete when we read it. */
+/* Smallest VBV we will hand the encoder (see the rc_buffer_size comments). */
+#define ANV_VA_MIN_VBV (128 * 1024)
+
+/* The VBV must hold several whole frames, otherwise iHD stops in the middle of
+ * the last slice when a frame does not fit (the decoder conceals the rest).
+ * 128 KB was enough while frames were ~40 KB; with vrlink asking 82 Mbit/s at
+ * 90 fps a frame is ~114 KB and can reach 133 KB, so the floor has to follow
+ * the per-frame budget. */
+static int64_t va_vbv_floor(uint64_t bitrate, uint32_t fps)
+{
+   uint64_t frame = (bitrate && fps) ? bitrate / 8 / fps : 0;
+   uint64_t floor = frame * 4;
+   return floor > ANV_VA_MIN_VBV ? (int64_t) floor : (int64_t) ANV_VA_MIN_VBV;
+}
+
+#define VA_QUEUE_LEN 32
+
+struct va_pending_job {
+   int64_t t_enqueue;
+   struct anv_device *device;
+   struct anv_video_session *vid;
+   struct anv_va_job job;
+   uint32_t n_signals;
+   struct vk_sync_signal signals[8];
+   /* GPU sync the worker waits on before encoding (the submission that
+    * recorded the staging copy), destroyed by the worker. */
+   struct vk_sync *gpu_sync;
+   struct vk_sync *destroy_sync;
+};
+
+/* Frame-pacing probes (anv_va_encode.c diagnostics): written by the submit
+ * thread and the worker, read by the next submit. */
+static int64_t va_last_enqueue;
+static int64_t va_last_packet_done;
+
+/* One encode queue/worker for the device.  The three destination slots have
+ * their own VA contexts (see va_sessions); the worker serialises the frames,
+ * but the contexts are independent. */
+struct va_pool {
+   pthread_mutex_t lock;
+   pthread_cond_t not_empty;
+   pthread_cond_t not_full;
+   struct va_pending_job q[VA_QUEUE_LEN];
+   unsigned head, tail, count;
+   pthread_t thread;
+   bool started;
+};
+static struct va_pool va_pool = {
+   .lock = PTHREAD_MUTEX_INITIALIZER,
+   .not_empty = PTHREAD_COND_INITIALIZER,
+   .not_full = PTHREAD_COND_INITIALIZER,
+};
+
+/* ---- per-image encode overlap ------------------------------------------
+ * In the direct-export path iHD reads the application's image itself.  If the
+ * application submits the same image again before the previous encode has
+ * finished, the encoder reads a picture the GPU is already rewriting - the
+ * corruption the direct path shows and the staging path does not.  Track it
+ * per image pointer and log every overlap. */
+#define VA_INFLIGHT_MAX 8
+static struct {
+   const struct anv_image *img;
+   uint32_t n;
+   int64_t since;
+} g_img_inflight[VA_INFLIGHT_MAX];
+static pthread_mutex_t g_img_inflight_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void va_img_enter(const struct anv_image *img)
+{
+   if (!img)
+      return;
+   pthread_mutex_lock(&g_img_inflight_lock);
+   for (int i = 0; i < VA_INFLIGHT_MAX; i++) {
+      if (g_img_inflight[i].img == img) {
+         if (g_img_inflight[i].n) {
+            static int logged;
+            if (logged++ < 200)
+               VLOG("IMAGE OVERLAP: img=%p submitted again with %u encode(s) "
+                    "still in flight (%.1f ms) - direct export reads a live "
+                    "image", (void *) img, g_img_inflight[i].n,
+                    (os_time_get_nano() - g_img_inflight[i].since) / 1e6);
+         } else {
+            g_img_inflight[i].since = os_time_get_nano();
+         }
+         g_img_inflight[i].n++;
+         pthread_mutex_unlock(&g_img_inflight_lock);
+         return;
+      }
+   }
+   for (int i = 0; i < VA_INFLIGHT_MAX; i++) {
+      if (!g_img_inflight[i].img || !g_img_inflight[i].n) {
+         g_img_inflight[i].img = img;
+         g_img_inflight[i].n = 1;
+         g_img_inflight[i].since = os_time_get_nano();
+         break;
+      }
+   }
+   pthread_mutex_unlock(&g_img_inflight_lock);
+}
+
+static void va_img_leave(const struct anv_image *img)
+{
+   if (!img)
+      return;
+   pthread_mutex_lock(&g_img_inflight_lock);
+   for (int i = 0; i < VA_INFLIGHT_MAX; i++)
+      if (g_img_inflight[i].img == img && g_img_inflight[i].n)
+         g_img_inflight[i].n--;
+   pthread_mutex_unlock(&g_img_inflight_lock);
+}
+
+static void *va_worker(void *arg)
+{
+   struct va_pool *pool = &va_pool;
+   (void) arg;
+   for (;;) {
+      pthread_mutex_lock(&pool->lock);
+      while (pool->count == 0)
+         pthread_cond_wait(&pool->not_empty, &pool->lock);
+      struct va_pending_job w = pool->q[pool->head];
+      pool->head = (pool->head + 1) % VA_QUEUE_LEN;
+      pool->count--;
+      pthread_cond_signal(&pool->not_full);
+      pthread_mutex_unlock(&pool->lock);
+      const int64_t t_deq = os_time_get_nano();
+
+      if (w.gpu_sync) {
+         /* The staging copy was recorded in the submission this sync stands
+          * for, so the buffer is complete once it signals. */
+         /* The frame's dma-buf carries the render fence, so if iHD honours
+          * implicit fencing the hardware can do this wait and the worker need
+          * not block.  ANV_VA_NO_CPU_WAIT=1 skips it to test exactly that. */
+         if (!va_env_flag("ANV_VA_NO_CPU_WAIT"))
+            vk_sync_wait(&w.device->vk, w.gpu_sync, 1, 0, UINT64_MAX);
+         vk_sync_destroy(&w.device->vk, w.gpu_sync);
+      }
+      anv_va_encode_job(w.device, w.vid, &w.job);
+      {
+         ANV_FROM_HANDLE(anv_image_view, iv2, w.job.src_view);
+         va_img_leave(iv2 ? iv2->image : NULL);
+      }
+   va_last_packet_done = os_time_get_nano();
+   {
+      static int64_t last_done;
+      char extra[64] = "";
+      if (last_done)
+         snprintf(extra, sizeof extra, ", gap since previous done %.1f ms",
+                  (va_last_packet_done - last_done) / 1e6);
+      last_done = va_last_packet_done;
+      /* Only when a frame is actually slow: this must not cost a log write
+       * per frame in the shipped build. */
+      if ((va_last_packet_done - w.t_enqueue) > 20000000)
+         VLOG("worker: queued->dequeue %.1f ms, dequeue->done %.1f ms, "
+              "back-to-app %.1f ms%s",
+              (t_deq - w.t_enqueue) / 1e6, (va_last_packet_done - t_deq) / 1e6,
+              (va_last_packet_done - w.t_enqueue) / 1e6, extra);
+   }
+      if (w.n_signals)
+         vk_sync_signal_many(&w.device->vk, w.n_signals, w.signals);
+      if (w.destroy_sync)
+         vk_sync_destroy(&w.device->vk, w.destroy_sync);
+   }
+   return NULL;
+}
+
+void anv_va_submit_job(struct anv_device *device,
+                       struct anv_video_session *vid,
+                       struct anv_va_job *job,
+                       uint32_t n_signals,
+                       const struct vk_sync_signal *signals,
+                       struct vk_sync *gpu_sync,
+                       struct vk_sync *destroy_sync)
+{
+   /* The encode takes ~6 ms; running it inline stalls the application's
+    * submit thread and delays its fence.  By default the work is handed to a
+    * worker thread and the application's signals (and the private sync the
+    * KMD signalled) are handled there.  vkGetQueryPoolResults waits for the
+    * packet, so the application still sees a ready feedback entry.
+    * ANV_VA_SYNC=1 restores the old fully synchronous behaviour. */
+   va_stage_on_submit_thread(device, job);
+   {   /* count this image as being encoded until the worker is done */
+      ANV_FROM_HANDLE(anv_image_view, iv, job->src_view);
+      va_img_enter(iv ? iv->image : NULL);
+   }
+
+   if (va_env_flag("ANV_VA_SYNC")) {
+      if (gpu_sync) {
+         if (!va_env_flag("ANV_VA_NO_CPU_WAIT"))
+            vk_sync_wait(&device->vk, gpu_sync, 1, 0, UINT64_MAX);
+         vk_sync_destroy(&device->vk, gpu_sync);
+      }
+      anv_va_encode_job(device, vid, job);
+      if (n_signals && vk_sync_signal_many(&device->vk, n_signals, signals) != VK_SUCCESS)
+         VLOG("signalling the application's syncs failed");
+      if (destroy_sync)
+         vk_sync_destroy(&device->vk, destroy_sync);
+      return;
+   }
+
+   struct va_pool *pool = &va_pool;
+   pthread_mutex_lock(&pool->lock);
+   if (!pool->started) {
+      pthread_create(&pool->thread, NULL, va_worker, NULL);
+      pool->started = true;
+   }
+   while (pool->count == VA_QUEUE_LEN)
+      pthread_cond_wait(&pool->not_full, &pool->lock);
+   job->fb_gen = feedback_clear(job->query_pool, job->query_index);
+   struct va_pending_job *w = &pool->q[pool->tail];
+   memset(w, 0, sizeof(*w));
+   w->t_enqueue = os_time_get_nano();
+   {   /* Frame pacing: how often the application hands us a frame, and how
+        * long after the previous packet it does so.  "back" is the number that
+        * decides whether the 100 ms frame period is ours or the app's. */
+      if (va_last_enqueue) {
+         const double gap = (w->t_enqueue - va_last_enqueue) / 1e6;
+         const double back = va_last_packet_done ?
+            (w->t_enqueue - va_last_packet_done) / 1e6 : -1;
+         if (gap > 20.0)
+            VLOG("pacing: %.1f ms since the previous frame (%.1f ms after the "
+                 "previous packet was ready)", gap, back);
+      }
+      va_last_enqueue = w->t_enqueue;
+   }
+   w->device = device; w->vid = vid; w->job = *job;
+   w->gpu_sync = gpu_sync;
+   w->n_signals = n_signals < 8 ? n_signals : 8;
+   for (uint32_t i = 0; i < w->n_signals; i++)
+      w->signals[i] = signals[i];
+   w->destroy_sync = destroy_sync;
+   pool->tail = (pool->tail + 1) % VA_QUEUE_LEN;
+   pool->count++;
+   pthread_cond_signal(&pool->not_empty);
+   pthread_mutex_unlock(&pool->lock);
+}
